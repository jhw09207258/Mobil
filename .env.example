# Supabase — 프로젝트 대시보드 > Settings > API 에서 확인
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Sophia (AI 어시스턴트) — NVIDIA NIM API 키. 서버(Server Action)에서만 쓰이며
# 클라이언트로는 절대 노출되지 않는다. https://build.nvidia.com 에서 발급.
# NVIDIA_API_KEY_2 는 선택 사항 — 두 번째 키를 등록해두면 매 요청마다 둘 중
# 하나로 무작위 로드밸런싱하고, 레이트리밋/장애 시 남은 키로 자동 재시도(failover)한다.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_API_KEY_2=nvapi-your-second-key-here

# Sophia 의 Gemini/Claude 백엔드 — 최소 하나는 있어야 동작한다. 둘 다 있으면
# 모델을 고를 수 있다. 없으면 해당 경로가 503 을 준다(대시보드 Connected
# Systems 에는 이 둘이 안 뜨니, 안 되면 먼저 /api/code-agent/health 로 확인할 것).
# GEMINI_API_KEY(=GOOGLE_API_KEY): https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=your-gemini-key-here
# CLAUDE_API_KEY(=ANTHROPIC_API_KEY): https://console.anthropic.com 에서 발급.
CLAUDE_API_KEY=sk-ant-your-key-here

# Sophia 의 논문/코드 통합 검색 도구 — GitHub 코드 검색용 Personal Access Token.
# github.com → Settings → Developer settings → Personal access tokens 에서
# public_repo 읽기 권한만 있는 토큰을 발급해 등록한다. 없어도 OpenAlex/
# Semantic Scholar 논문 검색은 정상 동작한다(GitHub 섹션만 비활성).
GITHUB_TOKEN=ghp_your-token-here

# 위 검색 도구용 — 둘 다 선택 사항. 없어도 동작하지만 설정하면 외부 API 레이트
# 리밋에 덜 걸려 검색이 더 안정적이다.
# OPENALEX_CONTACT_EMAIL: OpenAlex 에 요청 시 연락처로 실어 보내면 더 넉넉한
# "polite pool" 레이트리밋을 적용받는다. https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_CONTACT_EMAIL=you@example.com
# SEMANTIC_SCHOLAR_API_KEY: 비인증 요청은 5분당 100회로 매우 낮게 제한된다.
# https://www.semanticscholar.org/product/api#api-key-form 에서 발급.
SEMANTIC_SCHOLAR_API_KEY=your-key-here

# 채팅 알림 메일 — 새 메시지가 왔는데 앱을 안 보고 있는 사람에게 가입 이메일로
# 알린다. 둘 다 없으면 알림이 조용히 꺼진다(메시지 전송 자체는 정상 동작).
# RESEND_API_KEY: https://resend.com/api-keys 에서 발급.
# EMAIL_FROM: Resend 에서 인증(verify)한 도메인의 주소여야 한다. 도메인 인증
#   전에는 onboarding@resend.dev 로 본인에게만 보낼 수 있다.
RESEND_API_KEY=re_your-key-here
EMAIL_FROM=Possion <notifications@yourdomain.com>
# 메일 안의 링크가 가리킬 주소. Vercel 에서는 배포 도메인이 자동으로 잡히므로
# 커스텀 도메인을 쓸 때만 지정하면 된다.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# 웹 푸시 알림 — 앱을 닫아 두어도 도착하는 알림. 이게 없으면 새 메시지는
# 이메일로만 알리게 된다(기능이 조용히 꺼질 뿐 앱은 정상 동작한다).
#
# 키 한 쌍을 만들어 넣는다(한 번만):
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# 공개키는 브라우저로 나가므로 비밀이 아니고, 비밀키는 절대 노출하면 안 된다.
# 키를 바꾸면 기존 구독이 전부 무효가 되어 사용자들이 다시 켜야 한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 발생 시 연락할 곳. mailto: 또는 https: 주소.
VAPID_SUBJECT=mailto:admin@yourdomain.com

# 일정 알림("10분 뒤 회의")을 실제로 울리는 배치가 자신을 증명하는 값.
# 관리자 콘솔의 "EVENT REMINDER DISPATCH" 패널에서 발급해 그대로 붙여 넣는다.
# 비워 두면 채팅·초대 알림은 정상이고 시간 기반 알림만 꺼진다.
NOTIFY_DISPATCH_TOKEN=
# Vercel Cron 이 /api/push/dispatch 를 부를 때 쓰는 시크릿(Vercel 이 자동으로
# 주입한다). 직접 스케줄러를 붙일 때만 수동으로 지정하면 된다.
CRON_SECRET=
